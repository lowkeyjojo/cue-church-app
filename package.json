{
  "name": "cue",
  "productName": "Cue",
  "version": "0.9.0",
  "description": "Cue — a modern church presentation app. Find visuals privately, show them to the room intentionally.",
  "author": {
    "name": "Cue",
    "email": "chileanyway17@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://github.com/lowkeyjojo/cue-church-app",
  "main": "./out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/make-icons.mjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.mjs",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.mjs --mac",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.mjs --win",
    "dist:dir": "electron-vite build && electron-builder --config electron-builder.config.mjs --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/bebas-neue": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/react-virtual": "^3.14.23",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "44.10.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "lucide-react": "^1.63.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
